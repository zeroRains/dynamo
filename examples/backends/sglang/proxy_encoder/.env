# Sourced by launch_fake_disagg.sh and request_image.sh (set -a, exported to children). No secrets.

# Model path and served name, shared by frontend/encode/prefill/decode.
# Overridable by --model / --served-model-name (launch) and MODEL (request).
QWEN_MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct
SERVED_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# File-based discovery: no etcd/NATS needed. The kv dir is set by the launch script.
DYN_DISCOVERY_BACKEND=file

# Allow http://127.0.0.1 image URLs (rejected by default).
DYN_MM_ALLOW_INTERNAL=1

# IP decode uses to reach the prefill bootstrap. Auto-detection may pick docker0/IB on multi-NIC hosts.
# Single node: 127.0.0.1. Multi node: the real IP.
SGLANG_HOST_IP=127.0.0.1

# Keep the NIXL embedding transfer on-node. The default picks ud_mlx5 and times out here.
# Multi node: use a list that includes rc/ud.
UCX_TLS=self,sm,tcp,cuda_copy,cuda_ipc

# One GPU per worker.
DYN_ENCODE_WORKER_GPU=0
DYN_PREFILL_WORKER_GPU=1
DYN_DECODE_WORKER_GPU=2

# Ports. The two NCCL ports must differ (get_free_port races on concurrent start).
DYN_HTTP_PORT=8000
DYN_SYSTEM_PORT1=8081
DYN_SYSTEM_PORT2=8082
DYN_DISAGG_BOOTSTRAP_PORT=12345
DYN_PREFILL_NCCL_PORT=29601
DYN_DECODE_NCCL_PORT=29602
IMG_PORT=9001

# Image tiling: images with area > 512*512 are cut into tiles plus one whole-image item; smaller ones stay whole.
# Max tiles per image: single-image request / multi-image request. Multi-image tiling can be switched off.
FAKE_ENABLE_TILING=true
FAKE_ENABLE_TILING_MULTI_IMAGE=true
FAKE_MAX_TILES=16
FAKE_MAX_TILES_MULTI_IMAGE=9
